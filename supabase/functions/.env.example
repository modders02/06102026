# Copy this file to supabase/functions/.env for local secrets or CLI deployment.
# Use a Brevo REST API key from Settings > SMTP & API > API Keys.
# An SMTP key is not accepted by this integration.
BREVO_API_KEY=
BREVO_SENDER_NAME=MSDS Sentry Vision
# Optional: otherwise the function uses your first active verified Brevo sender.
# BREVO_SENDER_EMAIL=alerts@your-verified-domain.example
